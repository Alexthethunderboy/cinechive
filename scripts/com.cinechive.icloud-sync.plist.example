<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cinechive.icloud-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>--env-file=/ABSOLUTE/PATH/TO/enterarchive/.env.local</string>
    <string>/ABSOLUTE/PATH/TO/enterarchive/scripts/sync-icloud-media.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/enterarchive</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>600</integer>

  <key>StandardOutPath</key>
  <string>/tmp/cinechive-icloud-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cinechive-icloud-sync.error.log</string>
</dict>
</plist>
