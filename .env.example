# TMDB
TMDB_API_KEY=your-tmdb-api-key

# Server-only ingestion setting. Never prefix this with NEXT_PUBLIC_.
INGEST_API_SECRET=replace-with-a-long-random-secret

# The scanner runs on a Mac signed into iCloud Drive. Videos may remain
# cloud-only; cards default to this already-shared parent folder link.
ICLOUD_MEDIA_FOLDER="/Users/you/Library/Mobile Documents/com~apple~CloudDocs/CineChive Share"
ICLOUD_SHARED_FOLDER_URL=https://www.icloud.com/iclouddrive/your-shared-folder-id
CINECHIVE_INGEST_URL=https://cinechive.vercel.app/api/ingest

# Production catalogue persistence. Create an Upstash Redis database and keep
# both REST credentials server-only in Vercel Production and Preview.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Exact-title notifications. Generate the VAPID pair with
# `npx web-push generate-vapid-keys`; keep the private key server-only.
MEDIA_NOTIFICATIONS_ENABLED=false
CINECHIVE_SITE_URL=https://cinechive.vercel.app
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com
MEDIA_NOTIFICATION_SETUP_CODE=

# Optional email fallback. The sender must use a domain verified by Resend.
RESEND_API_KEY=
MEDIA_NOTIFICATION_EMAIL=
MEDIA_NOTIFICATION_FROM=CineChive <notifications@example.com>

# Legacy rollback only. The app prefers Upstash whenever both values above exist.
BLOB_READ_WRITE_TOKEN=

# Optional. Defaults to ./data/shared-media.json.
SHARED_MEDIA_DATA_FILE=

# Optional watch-provider enrichment
WATCHMODE_API_KEY=

# Supabase is opt-in. Keep disabled for the browser-only archive.
NEXT_PUBLIC_SUPABASE_ENABLED=false
NEXT_PUBLIC_SUPABASE_DISABLED=true
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
